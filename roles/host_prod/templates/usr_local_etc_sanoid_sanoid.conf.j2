# Managed by Ansible. Do not edit by hand.
#
# Note: /usr/local/bin/borg-daily-backup uses the latest daily snapshots for remote backups.

[zroot]
	use_template = local
	# Per-dataset recursion allows excluding specific datasets (below)
	recursive = yes

[zroot/var/cache]
	autosnap = no
	autoprune = yes
	monitor = no

[zroot/borg-work]
	autosnap = no
	autoprune = yes
	monitor = no

[template_local]
	autosnap = yes
	autoprune = yes

	frequently = 432
	frequent_period = 10

	hourly = 0
	daily = 14
	weekly = 0
	monthly = 0
	yearly = 0

	daily_hour = 23
	daily_min = 59
