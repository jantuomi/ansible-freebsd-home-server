[PARSER]
    Name        nginx_access
    Format      regex
    Regex       ^(?<log>(?<vhost>[^ ]+) (?<remote_addr>[^ ]+) - (?<remote_user>[^ ]+) \[(?<time>[^\]]+)\] "(?<request>[^"]*)" (?<status>[0-9]{3}) (?<body_bytes_sent>[0-9]+) "(?<http_referer>[^"]*)" "(?<http_user_agent>[^"]*)")$
    Time_Key    time
    Time_Format %d/%b/%Y:%H:%M:%S %z
    Time_Keep   On
    Types       status:integer body_bytes_sent:integer

[PARSER]
    Name        nginx_error
    Format      regex
    Regex       ^(?<log>(?<time>[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}) \[(?<level>[^\]]+)\] .*)$
    Time_Key    time
    Time_Format %Y/%m/%d %H:%M:%S
    Time_System_timezone On
    Time_Keep   On
