global:
  smtp_smarthost: {{ (smtp_host ~ ':' ~ smtp_port) | to_json }}
  smtp_from: {{ ('pursotin@' ~ dma_mail_hostname) | to_json }}
  smtp_hello: pursotin
  smtp_auth_username: {{ smtp_user | to_json }}
  smtp_auth_password_file: /usr/local/etc/alertmanager/smtp-password
  smtp_require_tls: true

route:
  receiver: email
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: email
    email_configs:
      - to: {{ dma_to_address | to_json }}
        send_resolved: true

inhibit_rules:
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: [instance, resource, mountpoint]
