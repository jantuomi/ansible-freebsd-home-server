scrape_configs:
  - job_name: pursotin
    scrape_interval: 15s
    static_configs:
      - targets:
          - "{{ hostvars[ansible_jail_host].lan_ipv4_cidr | ipv4_host }}:9100"
        labels:
          instance: pursotin

  - job_name: zfs
    scrape_interval: 30s
    scrape_timeout: 10s
    static_configs:
      - targets:
          - "{{ hostvars[ansible_jail_host].lan_ipv4_cidr | ipv4_host }}:9134"
        labels:
          instance: pursotin
