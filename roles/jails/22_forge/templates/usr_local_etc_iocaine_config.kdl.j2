state-directory "/var/db/iocaine"

http-server default {
    bind "{{ jail_ips.forge }}:42069"
    use handler-from=default metrics=metrics
}

declare-handler default language=roto {
    ai-robots-txt-path "/usr/local/share/iocaine/robots.json"
}

prometheus-server metrics {
    bind "{{ jail_ips.forge }}:42042"
    persist-path "/var/db/iocaine/qmk-metrics.json"
    persist-interval "1h"
}
